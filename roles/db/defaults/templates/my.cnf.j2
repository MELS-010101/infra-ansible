# {{ ansible_managed }}
# Файл управляется Ansible — правки руками будут перезаписаны при следующем прогоне.
# bind-address и port приходят из inventory/group_vars/db.yml,
# max_connections — из roles/db/defaults/main.yml.

[mysqld]
# Слушать только указанный адрес. 127.0.0.1 = без доступа из сети (безопасность по умолчанию).
bind-address = {{ mariadb_bind_address }}

# Порт MariaDB
port = {{ mariadb_port }}

# Лимит одновременных подключений
max_connections = {{ mariadb_max_connections }}

# Кодировка по умолчанию для новых баз (берётся из defaults роли)
character-set-server = {{ app_db_charset }}
collation-server     = {{ app_db_collation }}