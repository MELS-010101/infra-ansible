# {{ ansible_managed }}
# Файл управляется Ansible — правки руками будут перезаписаны при следующем прогоне.
# Защищённый файл с паролями для скрипта бэкапа. Права = 0600 (ставит задача в tasks),
# читает только root. Пароли приходят из vault и расшифровываются ansible на лету.
# Значения ОБЯЗАТЕЛЬНО в двойных кавычках: иначе # и ! в пароле сломают source в bash.
# Имена переменных должны совпадать с теми, что читает db_backup.sh (DB_BACKUP_PASS,
# BACKUP_ENCRYPT_PASS) — иначе скрипт не найдёт пароль и завершится с ошибкой.

# Пароль бэкап-юзера MariaDB (совпадает с vault_db_backup_user_password из пула юзеров)
DB_BACKUP_PASS="{{ vault_db_backup_user_password }}"

# Passphrase для шифрования архивов openssl (используется, только если backup_encrypt=true)
BACKUP_ENCRYPT_PASS="{{ vault_backup_encryption_pass }}"