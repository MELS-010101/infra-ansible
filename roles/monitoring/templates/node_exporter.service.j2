# {{ ansible_managed }}
# Файл управляется Ansible — правки руками будут перезаписаны при следующем прогоне.
# Пользователь и порт приходят из roles/monitoring/defaults/main.yml.

[Unit]
Description=Prometheus Node Exporter (метрики ОС)
After=network.target

[Service]
# Запуск от непривилегированного системного пользователя (без shell и home — безопаснее)
User={{ node_exporter_user }}
Group={{ node_exporter_user }}
Type=simple
# Бинарник лежит в /usr/local/bin (туда его кладёт задача unarchive в tasks)
ExecStart=/usr/local/bin/node_exporter --web.listen-address=:{{ node_exporter_port }}
Restart=on-failure

[Install]
WantedBy=multi-user.target