# {{ ansible_managed }}
# Файл управляется Ansible — правки руками будут перезаписаны при следующем прогоне.
# Здесь хранится строка подключения (DSN) экспортера СУБД, включая пароль из vault.
# Права на файл = 0600 (ставит задача в tasks), читает только владелец-сервис.
# Значение ОБЯЗАТЕЛЬНО в двойных кавычках: иначе systemd примет # в пароле за комментарий.

# DSN для go-mysql-driver: юзер:пароль@unix(сокет)/  — без TCP, т.к. host='localhost'.
# Имя юзера и сокет — из переменных; пароль — из vault (расшифруется ansible на лету).
# Если в пароле появятся символы @ / ( ) — их нужно будет URL-encode (например @ -> %40).
DATA_SOURCE_NAME="{{ mysqld_exporter_db_user }}:{{ vault_db_exporter_password }}@unix({{ mariadb_socket }})/"